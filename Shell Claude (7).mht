  a { color: var(--color-links); text-decoration: none; background-color: t=
ransparent; }
  a:hover { color: rgb(0, 86, 179); text-decoration: underline; }
  a:not([href]):not([tabindex]), a:not([href]):not([tabindex]):hover, a:not=
